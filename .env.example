# Variables d’environnement (copier vers `.env.local`)

# MongoDB (Atlas ou autre) — requis pour `/api/spots`
MONGODB_URI=mongodb+srv://...
# Optionnel : nom de la base (défaut `workout`)
# MONGODB_DB=workout

# Mapbox — token **public** (restrictions URL dans le dashboard Mapbox)
NEXT_PUBLIC_MAPBOX_TOKEN=pk...

# Mapbox — optionnel pour `/api/spots/travel` (Matrix côté serveur)
# Si absent, le serveur retombe sur NEXT_PUBLIC_MAPBOX_TOKEN (pk).
# En prod, préférer un token secret (restrictions IP / sans domaine web).
# MAPBOX_ACCESS_TOKEN=sk...
# ou
# MAPBOX_SECRET_TOKEN=sk...
