# Variables d’environnement (copier vers `.env.local`)

# MongoDB (Atlas ou autre) — requis pour `/api/spots` et les scripts
MONGODB_URI=mongodb+srv://...
# Optionnel : nom de la base (défaut `workout`)
# MONGODB_DB=workout

# Mapbox — token **public** (restrictions URL dans le dashboard Mapbox)
NEXT_PUBLIC_MAPBOX_TOKEN=pk...

# Vercel Blob — **uniquement** pour le script `npm run mirror-photos` (local ou CI)
# Ne pas exposer côté navigateur.
BLOB_READ_WRITE_TOKEN=vercel_blob_...
